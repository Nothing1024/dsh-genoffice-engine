{
  "name": "dsh-genoffice-sidebar",
  "description": "DSH sidebar unified ecosystem: TabsRoot (workspace/terminal/genoffice/files) + GenOffice quick preview + file manager + pty terminal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/src/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/src/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dshClient": {
    "inject": [
      "@deepseek-ai/dsh-client-runtime",
      "@deepseek-ai/dsh-client-ui-slots",
      "@deepseek-ai/dsh-client-ui-layout"
    ],
    "platform": "web"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json && tsdown"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/client.js.map",
    "lib/types/**/*.d.ts",
    "README.md"
  ],
  "peerDependencies": {
    "cordis": "^4.0.0-rc.7",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "~18.3.1",
    "@types/ws": "^8.18.1",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  }
}
